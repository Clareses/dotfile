{
  "lastChangelogVersion": "1.5.0",
  "theme": "ayu-mirage",
  "defaultProvider": "opencode-go",
  "defaultModel": "deepseek-v4.1-flash",
  "packages": [
    "npm:pi-vimmode",
    "npm:pi-ayu-themes",
    {
      "source": "https://github.com/nicobailon/pi-web-access.git",
      "extensions": [
        "+index.ts"
      ]
    },
    {
      "source": "packages/pi-ripwire",
      "extensions": [
        "+extensions/explore.ts"
      ],
      "skills": [
        "-skills/ripwire-before-you-build/SKILL.md",
        "-skills/ripwire-change-check/SKILL.md"
      ]
    },
    "npm:pi-input-history",
    "npm:pi-fff",
    "npm:@dietrichgebert/ponytail",
    "packages/pi-tidy-local"
  ],
  "extensions": [
    "+extensions/browser-zen/index.ts",
    "+extensions/web-fetch/index.ts",
    "+extensions/web-access-toggle.ts",
    "-builtin:llama.cpp",
    "-builtin:mcp"
  ],
  "defaultThinkingLevel": "low",
  "modelThinkingLevels": {
    "yun/gpt-5.4": "high",
    "yun/gpt-5.4-mini": "high",
    "yun/gpt-5.5": "high",
    "yun/gpt-5.6-luna": "high",
    "yun/gpt-5.6-sol": "high",
    "yun/gpt-5.6-terra": "high",
    "yun/gpt-6-astra": "high",
    "yun/gpt-6-sol": "high",
    "yun/gpt-6.1-sol": "high"
  },
  "hideThinkingBlock": true,
  "treeFilterMode": "no-tools",
  "doubleEscapeAction": "none",
  "tuiMode": "regular",
  "outputPad": 0,
  "terminal": {
    "showTerminalProgress": false
  },
  "tidy": {
    "userMessageStyle": "rail",
    "userMessageAlign": "left",
    "userMessagePaddingY": 1,
    "userMessageColors": {
      "rail": "accent",
      "rule": "borderMuted"
    },
    "messageBorderColors": {
      "user": "toolTitle"
    },
    "icons": true,
    "groupOpen": true
  },
  "editorPaddingX": 1,
  "extensionChangelogVersions": {
    "{\"source\":\"https://github.com/nicobailon/pi-web-access.git\",\"scope\":\"user\"}": "0.45.0"
  }
}